{
  "name": "@thaz/temporal-util",
  "version": "1.0.0-rc.1",
  "description": "Set of temporal utilities for applications and libraries in the thaz collective namespace",
  "keywords": [
    "date",
    "temporal",
    "valibot"
  ],
  "homepage": "https://github.com/thaz-collective/temporal-util#readme",
  "bugs": {
    "url": "https://github.com/thaz-collective/temporal-util/issues"
  },
  "license": "MIT",
  "author": "Tim Hazlett",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thaz-collective/temporal-util.git"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./formatter": {
      "types": "./dist/formatter.d.mts",
      "import": "./dist/formatter.mjs"
    },
    "./valibot": {
      "types": "./dist/valibot.d.mts",
      "import": "./dist/valibot.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "scripts": {
    "prepack": "vp run build",
    "taze": "vpx taze@latest -Ilwr --maturity-period 3",
    "taze:major": "vpx taze@latest major -Ilwr --maturity-period 3",
    "taze:minor": "vpx taze@latest minor -Ilwr --maturity-period 3",
    "taze:patch": "vpx taze@latest patch -Ilwr --maturity-period 3"
  },
  "devDependencies": {
    "@thaz/oxfmt-config": "catalog:",
    "@thaz/oxlint-config": "catalog:",
    "@thaz/typescript-config": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "@vitest/ui": "catalog:",
    "temporal-polyfill": "catalog:",
    "typescript": "catalog:",
    "valibot": "catalog:",
    "vite": "catalog:",
    "vite-plugin-externalize-deps": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "temporal-polyfill": "^1.0.3",
    "valibot": "^1.4.2"
  },
  "peerDependenciesMeta": {
    "temporal-polyfill": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.20.0"
}
